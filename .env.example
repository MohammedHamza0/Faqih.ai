# ─── Retrieval Settings ─────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=8
RRF_K=60
SEMANTIC_CACHE_THRESHOLD=0.92

# ─── Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── API Settings ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-this-to-a-secure-key
