# ─── LLM API Keys ────────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=faqih_neo4j_2024

# ─── Qdrant ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://faqih:faqih_pg_2024@localhost:5433/faqih

# ─── Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=aubmindlab/bert-base-arabertv2
EMBEDDING_DIM=768

# ─── LLM Settings ───────────────────────────────────────────
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.3
LLM_FALLBACK_PROVIDERS=groq,openrouter,cohere,openai

# ─── Default Models per Provider ────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=google/gemini-2.0-flash-exp
COHERE_MODEL=command-a-03-2025
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash

# ─── Retrieval Settings ─────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=8
RRF_K=60
SEMANTIC_CACHE_THRESHOLD=0.92

# ─── Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── API Settings ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-this-to-a-secure-key
