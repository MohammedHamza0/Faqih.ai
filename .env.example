# ─── Ollama (Local LLM) ──────────────────────────────────────
# Ollama must be running locally: https://ollama.com
# Pull required models: ollama pull qwen3:8b && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODELS=llama3.2

# ─── LLM Settings ───────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=faqih_neo4j_2024

# ─── Qdrant ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=8333
QDRANT_GRPC_PORT=8334

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:8379/0

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://faqih:faqih_pg_2024@localhost:5433/faqih

# ─── Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=aubmindlab/bert-base-arabertv2
EMBEDDING_DIM=768

# ─── Retrieval Settings ─────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=8
RRF_K=60
SEMANTIC_CACHE_THRESHOLD=0.92

# ─── Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:8379/1
CELERY_RESULT_BACKEND=redis://localhost:8379/2

# ─── API Settings ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-this-to-a-secure-key
