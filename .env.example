ANTHROPIC_API_KEY=sk-ant-...

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=faqih_neo4j_2024

# ─── Qdrant ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://faqih:faqih_pg_2024@localhost:5432/faqih

# ─── Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=aubmindlab/bert-base-arabertv2
EMBEDDING_DIM=768

# ─── LLM Settings ───────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
